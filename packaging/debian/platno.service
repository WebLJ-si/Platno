[Unit]
Description=Platno media server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=platno
Group=platno
EnvironmentFile=-/etc/default/platno
Environment=SMART_MEDIA_DATA=/var/lib/platno
Environment=SMART_MEDIA_DISTRIBUTION=deb
ExecStart=/usr/bin/platno
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target

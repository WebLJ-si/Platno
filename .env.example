# Set these in your shell; .env files are not automatically loaded.
TMDB_TOKEN=your-tmdb-read-access-token
# SMART_MEDIA_DATA=/path/outside/media
# SMART_MEDIA_HOST=127.0.0.1
# SMART_MEDIA_PORT=8787
# SMART_MEDIA_COOKIE_SECURE=1  # set only behind an HTTPS reverse proxy
# Optional local audio-based subtitle synchronization. Defaults detect Homebrew/PATH
# and SMART_MEDIA_DATA/models/ggml-base.bin. No audio is sent to an external API.
# SMART_MEDIA_WHISPER=/path/to/whisper-cli
# SMART_MEDIA_WHISPER_MODEL=/path/to/ggml-base.bin

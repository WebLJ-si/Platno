# Set these in your shell; .env files are not automatically loaded.
TMDB_TOKEN=your-tmdb-read-access-token
# SMART_MEDIA_DATA=/path/outside/media
# SMART_MEDIA_HOST=127.0.0.1
# SMART_MEDIA_PORT=8787
# Folder for temporary conversion (HLS/transcode) and speech-sync files. Default: system temp.
# Must be writable and outside your media folders. Overrides the owner setting in Settings.
# SMART_MEDIA_TRANSCODE_DIR=/fast-disk/plexv2-work
# SMART_MEDIA_COOKIE_SECURE=1  # set only behind an HTTPS reverse proxy
# Optional local audio-based subtitle synchronization. Defaults detect Homebrew/PATH
# and SMART_MEDIA_DATA/models/ggml-base.bin. No audio is sent to an external API.
# SMART_MEDIA_WHISPER=/path/to/whisper-cli
# SMART_MEDIA_WHISPER_MODEL=/path/to/ggml-base.bin

# Optional public HTTPS access. Disabled until enabled by the owner in Settings.
# Use a trusted certificate covering the hostname and reserve this server's LAN IP.
# The regular HTTP port must not be forwarded. See docs/remote-access.md.
# SMART_MEDIA_REMOTE_HOSTNAME=media.example.com
# SMART_MEDIA_REMOTE_IP=192.168.1.50
# SMART_MEDIA_REMOTE_PORT=8943
# SMART_MEDIA_TLS_CERT=/private/path/fullchain.pem
# SMART_MEDIA_TLS_KEY=/private/path/privkey.pem

# Optional disclosed diagnostic beta. Stable/source builds send nothing by default.
# See BETA.md before enabling or distributing this variant.
# SMART_MEDIA_RELEASE_CHANNEL=beta
# SMART_MEDIA_TELEMETRY_ENDPOINT=https://platno-observatory.vercel.app/api/ingest
# SMART_MEDIA_TELEMETRY=off  # force all diagnostics off, including embedded beta config

# Set production secrets in Vercel; never expose them to the browser.
APP_URL=https://your-project.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact verified Google account allowed to sign in. No fallback allow-list.
OWNER_EMAIL=
SESSION_SECRET=
# Upstash Redis from the Vercel Marketplace; private server-side credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional Vercel cron authentication for external cleanup/monitoring integrations.
